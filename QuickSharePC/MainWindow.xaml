<Window x:Class="QuickShare.PC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuickShare.PC"
        xmlns:converters="clr-namespace:QuickShare.PC.Converters"
        mc:Ignorable="d"
        Title="Quick Share (PC)" Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        Background="#F8F9FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <converters:FileSizeConverter x:Key="FileSizeConverter" />
        <converters:StatusColorConverter x:Key="StatusColorConverter" />

        <!-- Modern Style Definitions -->
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButtonStyle">
            <Setter Property="Background" Value="#1A73E8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1557B0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButtonStyle">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1A73E8" />
            <Setter Property="BorderBrush" Value="#1A73E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F3F4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Controls and Settings -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel>
                <!-- Service Status Card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="服务状态" Style="{StaticResource HeaderStyle}" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,10">
                            <Ellipse Width="12" Height="12" Fill="{Binding ServerStatusText, Converter={StaticResource StatusColorConverter}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerStatusText}" FontWeight="Bold" FontSize="14" Foreground="#3C4043" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,15">
                            <TextBlock Text="{Binding ConnectedDevice, StringFormat='📱 连接设备: {0}'}" FontSize="13" Foreground="#5F6368" Margin="0,0,0,5" />
                            <TextBlock Text="{Binding Port, StringFormat='🔌 监听端口: {0}'}" FontSize="13" Foreground="#5F6368" />
                        </StackPanel>

                        <Button Grid.Row="3" Command="{Binding ToggleServerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Background" Value="#EA4335" />
                                            <Setter Property="Content" Value="🛑 停止服务" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="False">
                                            <Setter Property="Background" Value="#1A73E8" />
                                            <Setter Property="Content" Value="▶️ 启动服务" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Network Status Card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="网络状态" Style="{StaticResource HeaderStyle}" />

                        <!-- IP Highlight Box -->
                        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DADCE0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="📡 本机局域网 IP" FontSize="11" Foreground="#5F6368" Margin="0,0,0,3" />
                                    <TextBlock Text="{Binding PrimaryLanIp}" FontSize="16" FontWeight="Bold" Foreground="#1A73E8" FontFamily="Consolas, Microsoft YaHei UI" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding CopyIpCommand}" Content="📋 复制" Style="{StaticResource SecondaryButtonStyle}" Height="30" Padding="10,3" VerticalAlignment="Center" ToolTip="复制 IP 到剪贴板" />
                            </Grid>
                        </Border>

                        <!-- Network Details -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <Grid Margin="0,2">
                                <TextBlock Text="当前网络:" FontSize="12" Foreground="#5F6368" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding PrimaryNetworkType}" FontSize="12" FontWeight="SemiBold" Foreground="#3C4043" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="适配器名称:" FontSize="12" Foreground="#5F6368" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding PrimaryAdapterName}" FontSize="12" FontWeight="SemiBold" Foreground="#3C4043" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="传输端口:" FontSize="12" Foreground="#5F6368" HorizontalAlignment="Left" />
                                <TextBlock Text="{Binding Port, StringFormat='{}{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#3C4043" HorizontalAlignment="Right" />
                            </Grid>
                            <Border Background="#E8F0FE" CornerRadius="4" Padding="8,6" Margin="0,8,0,0">
                                <TextBlock Text="💡 提示: 在手机端连接页面输入上方 IP 与端口即可极速互传" FontSize="11" Foreground="#1A73E8" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>

                        <Button Grid.Row="3" Content="🔄 刷新网络信息" Command="{Binding RefreshInterfacesCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="32" />
                    </Grid>
                </Border>

                <!-- Settings Card -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="设置" Style="{StaticResource HeaderStyle}" />

                        <!-- Save Directory -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,15">
                            <TextBlock Text="📁 文件接收保存目录" FontSize="13" FontWeight="SemiBold" Foreground="#3C4043" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedSaveDir, Mode=TwoWay}" IsReadOnly="True" Background="#F1F3F4" BorderBrush="#DADCE0" BorderThickness="1" Padding="5" Height="28" Grid.Column="0" VerticalContentAlignment="Center" ToolTip="{Binding SelectedSaveDir}" />
                                <Button Grid.Column="1" Command="{Binding BrowseSaveDirCommand}" Content="浏览..." Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Margin="5,0,0,0" Width="55" Height="28" />
                            </Grid>
                            <Button Content="📂 打开此目录" Command="{Binding OpenSaveDirCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Margin="0,5,0,0" />
                        </StackPanel>

                        <!-- Port -->
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔌 服务端监听端口" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#3C4043" />
                            <TextBox Text="{Binding Port, Mode=TwoWay}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Grid.Column="1" Height="28" BorderBrush="#DADCE0" BorderThickness="1" />
                        </Grid>

                        <!-- Auto Start -->
                        <CheckBox Grid.Row="3" IsChecked="{Binding AutoStart, Mode=TwoWay}" Content="🚀 开机自动启动服务端 (托盘模式)" FontSize="13" Foreground="#3C4043" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right Column: Files & Transfers -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Drag and Drop Panel -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" AllowDrop="True" Drop="FileDropPanel_Drop" DragEnter="FileDropPanel_DragEnter" Background="#F1F8FF" BorderBrush="#A3C7FF" BorderThickness="1.5">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📥 拖拽文件或文件夹到此处发送到手机" FontSize="14" FontWeight="SemiBold" Foreground="#1A73E8" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <TextBlock Grid.Row="1" Text="或" FontSize="12" Foreground="#5F6368" HorizontalAlignment="Center" Margin="0,0,0,5" />
                    <Button Grid.Row="2" Content="📂 打开文件管理器选择文件" Command="{Binding SelectAndSendFilesCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="32" Width="200" HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Bottom Tabs: Transfers & Logs -->
            <TabControl Grid.Row="1" Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1">
                <!-- Active Transfers -->
                <TabItem Header=" 当前传输 ">
                    <Grid Background="#FFFFFF" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="活动任务" FontWeight="SemiBold" FontSize="13" Foreground="#3C4043" Margin="0,0,0,10" />
                        <ListView Grid.Row="1" ItemsSource="{Binding TransferTasks}" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F3F4" BorderThickness="0,0,0,1" Padding="5,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- File name and dir -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                                                <Border Background="#E8F0FE" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Direction}" Foreground="#1A73E8" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" Foreground="#202124" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <ProgressBar Grid.Row="1" Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" Background="#F1F3F4" Foreground="#1A73E8" Margin="0,0,0,5" />

                                            <!-- Details -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding BytesTransferred, Converter={StaticResource FileSizeConverter}}" FontSize="11" Foreground="#5F6368" />
                                                <TextBlock Text=" / " FontSize="11" Foreground="#5F6368" />
                                                <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="11" Foreground="#5F6368" />
                                                <TextBlock Text="  |  " FontSize="11" Foreground="#DADCE0" />
                                                <TextBlock Text="{Binding Speed}" FontSize="11" Foreground="#1A73E8" FontWeight="SemiBold" />
                                            </StackPanel>

                                            <!-- Status -->
                                            <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" FontSize="13" Margin="10,0,5,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- History -->
                <TabItem Header=" 历史记录 ">
                    <Grid Background="#FFFFFF" Margin="10">
                        <ListView ItemsSource="{Binding TransferHistories}" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F3F4" BorderThickness="0,0,0,1" Padding="5,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#F1F3F4" CornerRadius="3" Padding="5,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Direction}" FontSize="11" Foreground="#5F6368" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="13" Foreground="#202124" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="300" />
                                            <TextBlock Grid.Column="2" Text="{Binding SizeString}" FontSize="12" Foreground="#5F6368" Margin="15,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding TimeString}" FontSize="12" Foreground="#5F6368" Margin="15,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}" FontSize="12" Margin="15,0,5,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Logs -->
                <TabItem Header=" 日志记录 ">
                    <Grid Background="#FFFFFF" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" Background="#F8F9FA" BorderBrush="#DADCE0" BorderThickness="1" Padding="8" FontFamily="Consolas, Courier New" FontSize="11.5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        <Button Grid.Row="1" Content="🗑️ 清除日志" Command="{Binding ClearLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Right" Width="100" Height="28" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
